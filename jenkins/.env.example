# Copy to jenkins/.env (never committed) and fill in. Keys for Render, Netlify and GitHub are NOT
# kept here: add them in Jenkins → Manage Jenkins → Credentials (jenkins/README.md).
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-to-a-long-password
JENKINS_URL=http://localhost:8080/

# Deploy stages run only when this is "yes" (first: checks only; Render auto-deploy still on).
DEPLOY_ENABLED=no
STAGING_API_URL=
STAGING_SITE_URL=
PRODUCTION_API_URL=https://melantha-guitar-api.onrender.com
PRODUCTION_SITE_URL=https://melantha-guitar-academy.netlify.app

# Optional
NOTIFY_EMAIL=
VITE_SENTRY_DSN=
