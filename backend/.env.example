# Copy to .env for running the API on your own computer.
# Your local PostgreSQL (create an empty database "guitar_dev" first), e.g.:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/guitar_dev
# Plain http on your own computer:
COOKIE_SECURE=false
# No email service on your own computer: reset links are printed in the server log.
EMAIL_LOG_LINKS=true
